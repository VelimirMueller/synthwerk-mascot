# synthwerk-mascot settings. Every variable is optional; the defaults suit local development.
# The mascot has no secrets.
SYNTHWERK_PLATFORM_ENV=local
SYNTHWERK_MASCOT_LOG_LEVEL=INFO
SYNTHWERK_MASCOT_LOG_FORMAT=json
SYNTHWERK_MASCOT_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
SYNTHWERK_MASCOT_MODEL_DIR=models/multilingual-e5-small
SYNTHWERK_MASCOT_INDEX_DIR=index
SYNTHWERK_MASCOT_ORT_THREADS=2
SYNTHWERK_MASCOT_TOP_K=3
SYNTHWERK_MASCOT_MIN_SCORE=0.78
SYNTHWERK_MASCOT_MIN_MARGIN=0.045
SYNTHWERK_MASCOT_MAX_QUESTION_CHARS=300
SYNTHWERK_MASCOT_RATE_LIMIT_PER_CLIENT=6
SYNTHWERK_MASCOT_RATE_LIMIT_GLOBAL=60
SYNTHWERK_MASCOT_RATE_LIMIT_WINDOW_S=60
SYNTHWERK_MASCOT_RATE_LIMIT_MAX_CLIENTS=10000
# uvicorn: the proxy whose X-Forwarded-For names the client (the edge). The image sets 127.0.0.1.
FORWARDED_ALLOW_IPS=127.0.0.1
